rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    // Public catalog queries must filter to published and approved items.
    match /videos/{videoId} {
      allow read: if (resource.data.isPublished == true && resource.data.moderationStatus == 'approved') || isAdmin();
      allow write: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }
    // Profile documents are private; a user can only read/update their own profile.
    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
      match /favorites/{videoId} {
        allow read, write, delete: if signedIn() && request.auth.uid == userId;
      }
    }
    // User-submitted metadata is private and cannot be made public by its owner.
    match /submissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if (signedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }
    // Deny every unspecified document by default.
    match /{document=**} { allow read, write: if false; }
  }
}
